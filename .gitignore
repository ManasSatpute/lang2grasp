runs/
logs/*
!logs/.gitkeep
__pycache__/
*.py[cod]
*.zip
*.pkl
*.mp4
.pytest_cache/
.ruff_cache/

# generated by src/scripts/rollout_all_objects.py (results CSV, plot, rollout videos)
src/results/

# LLM-extracted object snapshots, generated by src/scripts/extract_object_params.py --
# regenerate with `python src/scripts/extract_object_params.py --backend <backend>`.
# prompts.json is the input (not output) and width_mass_set/ is analytically generated
# (not LLM-extracted, see generate_width_mass_objects.py), so neither is ignored here.
src/configs/objects/*.json
!src/configs/objects/prompts.json

# generated by src/objects/force_gripper.py (derived panda_gripper.xml, rebuilt from
# whatever robosuite version is installed -- see its module docstring)
src/objects/_generated/

# Python virtual environments
.venv/
venv/
env/

# LLM backend API keys (ANTHROPIC_API_KEY / OPENAI_API_KEY / GROQ_API_KEY etc.)
.env
.env.*
!.env.example

# OS / editor cruft
.DS_Store
.idea/
